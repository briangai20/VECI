# Copiá este archivo como .env.local y completá con los datos de Supabase
# (Project Settings > API Keys). En Vercel van en Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Avisos por mail (opcionales: sin estas, la app anda pero no manda mails).
# SECRETAS: en Vercel marcarlas como "Secreto" y nunca ponerles NEXT_PUBLIC_.
RESEND_API_KEY=
SUPABASE_SECRET_KEY=
# Remitente con dominio verificado en Resend. Sin dominio, Resend solo deja
# mandar desde onboarding@resend.dev y únicamente al mail de tu cuenta.
MAIL_REMITENTE=
